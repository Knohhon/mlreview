{
  "description": "MLReview: снимок сессии, Ruff после правок, Ruff и pytest перед завершением.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$(git rev-parse --show-toplevel)/.codex/hooks/checks.py\" start",
            "timeout": 30,
            "statusMessage": "MLReview: снимок файлов сессии"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$(git rev-parse --show-toplevel)/.codex/hooks/checks.py\" file",
            "timeout": 120,
            "statusMessage": "MLReview: Ruff изменённых Python-файлов"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$(git rev-parse --show-toplevel)/.codex/hooks/checks.py\" stop",
            "timeout": 600,
            "statusMessage": "MLReview: Ruff, pytest и актуальность документации"
          }
        ]
      }
    ]
  }
}
